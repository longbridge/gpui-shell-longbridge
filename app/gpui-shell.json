{
  "id": "com.longbridge.desktop-lite",
  "name": "Longbridge Lite",
  "version": "0.4.0",
  "shell-version": "0.1.0",
  "entry": "main.js",
  "capabilities": {
    "fs": {
      "read": ["${pluginDir}"]
    },
    "network": {
      "hosts": ["openapi.longbridge.com", "openapi-quote.longbridge.com"]
    },
    "storage": true,
    "clipboard": {
      "write": true
    },
    "process": {
      "exit": true
    }
  }
}
