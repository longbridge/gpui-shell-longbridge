{
  "id": "com.longbridge.gpui-shell-example",
  "name": "Longbridge gpui-shell-example",
  "version": "0.4.0",
  "shell-version": "0.1.0",
  "entry": "main.js",
  "dependencies": {
    "omarchy-ui": "huacnlee/omarchy-ui#longbridge-components"
  },
  "capabilities": {
    "fs": {
      "read": ["${pluginDir}"]
    },
    "network": {
      "hosts": [
        "openapi.longbridge.com",
        "openapi-quote.longbridge.com"
      ]
    },
    "storage": true,
    "clipboard": {
      "write": true
    },
    "process": {
      "exit": true
    }
  }
}
